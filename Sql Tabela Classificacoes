DROP TABLE IF EXISTS `classificacoes_tributarias`;

CREATE TABLE `classificacoes_tributarias` (
    `id` INT(11) NOT NULL AUTO_INCREMENT,
    `cst` VARCHAR(10) NOT NULL COMMENT 'Código CST',
    `cst_nome` VARCHAR(255) DEFAULT NULL COMMENT 'Nome do CST',
    `cclasstrib` VARCHAR(20) NOT NULL COMMENT 'Código da Classificação Tributária',
    `classif_nome` VARCHAR(500) DEFAULT NULL COMMENT 'Nome da Classificação',
    `classif_nomereduzido` VARCHAR(200) DEFAULT NULL COMMENT 'Nome Reduzido da Classificação',
    `cst_exigetributacao` VARCHAR(3) DEFAULT 'Nao' COMMENT 'Exige Tributação?',
    `cst_reducaobc` VARCHAR(3) DEFAULT 'Nao' COMMENT 'Redução BC?',
    `cst_reducaoaliquota` VARCHAR(3) DEFAULT 'Nao' COMMENT 'Redução Alíquota?',
    `cst_transfcredito` VARCHAR(3) DEFAULT 'Nao' COMMENT 'Transferência de Crédito?',
    `cst_diferimento` VARCHAR(3) DEFAULT 'Nao' COMMENT 'Diferimento?',
    `cst_monofasica` VARCHAR(3) DEFAULT 'Nao' COMMENT 'Monofásica?',
    `cst_credpresibszfm` VARCHAR(3) DEFAULT 'Nao' COMMENT 'Crédito Presumido IBS ZFM?',
    `cst_ajustecredito` VARCHAR(3) DEFAULT 'Nao' COMMENT 'Ajuste de Crédito?',
    `percredibs` DECIMAL(10,4) DEFAULT NULL COMMENT 'Percentual Redução IBS',
    `percredcbs` DECIMAL(10,4) DEFAULT NULL COMMENT 'Percentual Redução CBS',
    `tributacaoregular` VARCHAR(3) DEFAULT 'Nao' COMMENT 'Tributação Regular?',
    `creditopresumido` VARCHAR(3) DEFAULT 'Nao' COMMENT 'Crédito Presumido?',
    `estornocredito` VARCHAR(3) DEFAULT 'Nao' COMMENT 'Estorno de Crédito?',
    `percbiocombustivel` VARCHAR(3) DEFAULT 'Nao' COMMENT 'PercBio Combustível?',
    `monofasica_tipos` VARCHAR(100) DEFAULT NULL COMMENT 'Tipos de Monofásica',
    `tipoaliquota` VARCHAR(50) DEFAULT NULL COMMENT 'Tipo de Alíquota',
    `rb_simplesnacional` VARCHAR(50) DEFAULT NULL COMMENT 'RB Simples Nacional',
    `dfes_relacionados` VARCHAR(255) DEFAULT NULL COMMENT 'DFes Relacionados',
    `legislacao` VARCHAR(500) DEFAULT NULL COMMENT 'URL da Legislação',
    `vigencia_inicio` DATE DEFAULT NULL COMMENT 'Início da Vigência',
    `vigencia_fim` DATE DEFAULT NULL COMMENT 'Fim da Vigência',
    `ncm` VARCHAR(20) DEFAULT NULL COMMENT 'Código NCM',
    `nbs` VARCHAR(20) DEFAULT NULL COMMENT 'Código NBS',
    `created_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP COMMENT 'Data de Criação',
    PRIMARY KEY (`id`),
    INDEX `idx_cst` (`cst`),
    INDEX `idx_cclasstrib` (`cclasstrib`),
    INDEX `idx_ncm` (`ncm`),
    INDEX `idx_nbs` (`nbs`),
    INDEX `idx_vigencia` (`vigencia_inicio`, `vigencia_fim`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Classificações Tributárias - SVRS';
